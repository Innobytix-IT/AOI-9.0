# AOI 9.0 – Webspace-Schutz
# Als ".htaccess" hochladen, ins selbe Verzeichnis wie aoi_signal.php

# aoi_token.php darf nicht direkt abgerufen werden
<Files "aoi_token.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</Files>

# aoi_data/*.php darf nicht direkt abgerufen werden
# (Zusatzschutz – das .htaccess im Unterordner ist die Hauptschranke)
<FilesMatch "^aoi_data/">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
