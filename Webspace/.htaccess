# AOI 9.0 – Webspace-Schutz
# Hochladen als ".htaccess" ins selbe Verzeichnis wie aoi_signal.php

# aoi_data/ darf nicht direkt per HTTP abgerufen werden.
# Die .php-Dateien darin würden ohnehin nur <?php exit; ?> ausführen,
# aber besser zwei Schranken als eine.
<IfModule mod_authz_core.c>
    <Directory "aoi_data">
        Require all denied
    </Directory>
</IfModule>
<IfModule !mod_authz_core.c>
    <Directory "aoi_data">
        Order deny,allow
        Deny from all
    </Directory>
</IfModule>

# aoi_token.php darf ebenfalls nicht direkt abgerufen werden.
<Files "aoi_token.php">
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
</Files>
